{
  "ts-node": {
    "files": true
  },
  "include": [
    "./index.ts"
  ],
  "exclude": [
    "./index.js"
  ],
  "compilerOptions": {
    "strict": true,
    "outDir": "./",
    "rootDir": "./",
    "target": "es2021",
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "es2021", "ES2021.String"],
  }
}